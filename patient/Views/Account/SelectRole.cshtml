<div class="container text-center mt-5">
    @if (User.IsInRole("Admin"))
    {
        <h2 class="mb-4">Welcome Admin</h2>
        <a asp-controller="Admin" asp-action="CreateDoctor" class="btn btn-dark btn-lg px-5 py-3">Create Doctor</a>
    }
    else
    {
        <h3>Please select account type to continue</h3>
        <p>Do you wish to register as a doctor or a patient</p>

        <div class="mt-4">
            <a asp-controller="Account" asp-action="RegisterPatient" class="btn btn-outline-primary btn-lg mx-2">Patient</a>
        </div>
    }
</div>