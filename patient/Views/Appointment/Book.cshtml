@model TimeSlot

@{
    ViewData["Title"] = "Conforming App";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h3> Confirm Appointment Booking </h3>
                </div>
                <div class="card-body">
                    @if (Model == null)
                    {
                        <div class="alert alert-danger">Appointment not available or booked</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <h5>Doctor name: <span class="text-primary">@Model.Doctor?.Name</span></h5>
                            <p class="text-muted"> Specilaized @Model.Doctor?.Specialization</p>
                            <hr />
                            <p><strong>Booking Appointment:</strong> @Model.SlotDate.ToString("yyyy-MM-dd HH:mm")</p>
                        </div>

                        <form asp-controller="Appointment" asp-action="ConfirmBooking" method="post">
                            @Html.AntiForgeryToken()

                            
                            <input type="hidden" name="timeSlotId" value="@Model.Id" />

                            <button type="submit" class="btn btn-success w-100">Confirm the booking</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>