@model Doctor

@{
    ViewData["Title"] = "Doctor's Patients";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <h2>Patients List for: <span class="text-primary">Dr. @Model.Name</span></h2>
            <p class="text-muted mb-0">Specialization: @Model.Specialization</p>
        </div>
    </div>

    @{
        var bookedSlots = Model.TimeSlots?
        .Where(t => t.IsBooked && t.Appointment != null)
        .ToList();
    }

    @if (bookedSlots == null || !bookedSlots.Any())
    {
        <div class="alert alert-info text-center">No bookings registered for this doctor yet.</div>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Patient Name</th>
                    <th>Phone Number</th>
                    <th>Email Address</th>
                    <th>Booking Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in bookedSlots)
                {
                    <tr>
                        <td>@slot.Appointment?.Patient?.Name</td>
                        <td>@slot.Appointment?.Patient?.Phone</td>
                        <td>@slot.Appointment?.Patient?.Email</td>
                        <td>
                            <span class="badge bg-success">@slot.SlotDate.ToString("yyyy-MM-dd HH:mm")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a asp-controller="Appointment" asp-action="BookAppointment" class="btn btn-secondary">Back to Booking List</a>
    </div>
</div>